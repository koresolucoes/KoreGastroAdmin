# Expostas apenas no navegador. Use as chaves públicas do mesmo projeto Supabase.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Deixe vazio quando frontend e API estiverem neste mesmo deploy Vercel.
VITE_API_BASE_URL=

# Somente no servidor Vercel. Nunca prefixe estas variáveis com VITE_.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sua-chave-service-role-secreta

# Lista separada por vírgula. Estes e-mails não podem remover a si mesmos pelo painel.
ROOT_ADMIN_EMAILS=admin@chefos.online

# Necessário apenas se o frontend usar uma URL de API de outra origem.
ADMIN_ALLOWED_ORIGINS=https://admin.chefos.online

# URL pública usada nos convites enviados pelo Supabase Auth.
ADMIN_APP_URL=https://admin.chefos.online

# Ative somente depois que os administradores privilegiados cadastrarem MFA.
# Quando true, ações de escrita marcadas como mfa_required exigem sessão AAL2.
ADMIN_ENFORCE_MFA=false

# Reserve para a etapa de diagnósticos agendados; use uma chave aleatória longa.
CRON_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
