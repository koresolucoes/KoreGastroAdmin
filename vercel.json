{
  "version": 2,
  "rewrites": [
    { "source": "/api/admin/health", "destination": "/api/admin/health-composite" },
    { "source": "/api/v2/admin/health", "destination": "/api/admin/health-composite" },
    { "source": "/api/v2/admin/:path*", "destination": "/api/admin/:path*" },
    { "source": "/api/v2/health", "destination": "/api/admin/health-composite" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
